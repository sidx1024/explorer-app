// Windows resources embedded into explorer-app.exe (compiled by build.rs, which defines
// VERSION_NUM and VERSION_STR from Cargo.toml).
1 ICON "assets/explorer-app.ico"

1 VERSIONINFO
FILEVERSION VERSION_NUM
PRODUCTVERSION VERSION_NUM
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "sidx1024"
      VALUE "FileDescription", "Explorer App"
      VALUE "ProductName", "Explorer App"
      VALUE "FileVersion", VERSION_STR
      VALUE "ProductVersion", VERSION_STR
      VALUE "InternalName", "explorer-app"
      VALUE "OriginalFilename", "explorer-app.exe"
      VALUE "LegalCopyright", "Copyright (c) sidx1024"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
